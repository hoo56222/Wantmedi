{
  "info": {
    "name": "Wantmedi Local Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get sample hospital",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response matches the sample hospital', () => {",
              "  pm.expect(pm.response.json()).to.deep.equal({",
              "    id: 1,",
              "    name: '샘플병원',",
              "    address: '서울특별시 중구'",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:8080/api/hospitals/1"
      }
    }
  ]
}
