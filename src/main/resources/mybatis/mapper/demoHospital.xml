<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sp.app.mapper.DemoHospitalMapper">
	<resultMap id="hospitalResult" type="com.sp.app.domain.dto.DemoHospitalDto">
		<constructor>
			<idArg column="id" javaType="_long"/>
			<arg column="name" javaType="string"/>
			<arg column="address" javaType="string"/>
		</constructor>
	</resultMap>

	<select id="findHospital" resultMap="hospitalResult">
		SELECT id, name, address
		FROM demo_hospital
		WHERE id = #{id}
	</select>
</mapper>
